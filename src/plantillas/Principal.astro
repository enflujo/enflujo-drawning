---
import Seo from '../componentes/Seo.astro';
import DatosEstructurados from '../componentes/DatosEstructurados.astro';
import '../scss/estilos.scss';

export interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const { titulo, descripcion, imagen } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo titulo={titulo} descripcion={descripcion} imagen={imagen} />
    <DatosEstructurados />
  </head>
  <body id="superficie">
    <slot />
    <script src="../programa.ts"></script>
  </body>
</html>
